@page "/item-manager"
@attribute [Authorize(Policy = AdminPolicies.Administrator)]
@using Microsoft.Extensions.Logging
@using MUnique.OpenMU.DataModel.Configuration
@using MUnique.OpenMU.DataModel.Configuration.Items
@using MUnique.OpenMU.DataModel.Entities
@using MUnique.OpenMU.Persistence
@using MUnique.OpenMU.Web.AdminPanel.Services
@inject ItemGrantService ItemGrant
@inject IDataSource<GameConfiguration> ConfigData
@inject ILogger<ItemManager> Logger

<PageTitle>OpenMU: Item Manager</PageTitle>
<Breadcrumb IsFirstFromRoot="true" Caption="Item Manager" />
<h1>Item Manager</h1>

<div class="alert alert-warning" role="alert">
    <strong>Offline characters only!</strong> Granting or removing items only works reliably for characters that are
    <strong>logged out</strong> — an online player's in-game inventory overwrites database edits within minutes.
    Ask the player to log out first.
</div>

@if (_error is not null)
{
    <div class="alert alert-danger" role="alert">@_error</div>
}

<div class="row mb-2">
    <div class="col-auto">
        <label class="form-label" for="loginInput">Account login name</label>
        <input id="loginInput" class="form-control" @bind="_loginName" placeholder="e.g. admin1" />
    </div>
    <div class="col-auto align-self-end">
        <button class="btn btn-primary" @onclick="SearchAccountAsync" disabled="@_loading">
            @(_loading ? "Loading..." : "Load account")
        </button>
    </div>
</div>

@if (_account is not null)
{
    <h4>Account: @_account.LoginName</h4>

    <h5>Characters</h5>
    @if (!_account.Characters.Any())
    {
        <p class="text-muted">No characters on this account.</p>
    }
    else
    {
        <ul class="list-group mb-3">
            @foreach (var character in _account.Characters)
            {
                var isSelected = _selectedCharacter is not null && character.GetId() == _selectedCharacter.GetId();
                <li class="list-group-item @(isSelected ? "active" : null)">
                    <button class="btn btn-link p-0 align-baseline" @onclick="() => SelectCharacter(character)">
                        @character.Name
                    </button>
                    @if (isSelected)
                    {
                        <span class="badge bg-secondary ms-2">selected</span>
                    }
                </li>
            }
        </ul>
    }

    @if (_selectedCharacter is not null)
    {
        <h5>Inventory of @_selectedCharacter.Name</h5>
        <table class="table table-sm table-striped">
            <thead>
            <tr>
                <th>Slot</th>
                <th>Item</th>
                <th>Level</th>
                <th>Durability</th>
                <th></th>
            </tr>
            </thead>
            <tbody>
            @foreach (var item in _selectedCharacter.Inventory?.Items.OrderBy(i => i.ItemSlot) ?? Enumerable.Empty<Item>())
            {
                <tr>
                    <td>@item.ItemSlot</td>
                    <td>@(item.Definition?.Name ?? "(unknown definition)") (@(item.Definition?.Group ?? 0)/@(item.Definition?.Number ?? 0))</td>
                    <td>@item.Level</td>
                    <td>@item.Durability</td>
                    <td>
                        <button class="btn btn-sm btn-outline-danger" @onclick="() => RemoveItemAsync(item)">Remove</button>
                    </td>
                </tr>
            }
            </tbody>
        </table>

        <h6>Add item</h6>
        <div class="row g-2">
            <div class="col-auto">
                <input class="form-control" @bind="_definitionFilter" placeholder="filter item by name" />
            </div>
            <div class="col-auto">
                <select class="form-select" @bind="_selectedDefinitionId">
                    <option value="">-- pick item --</option>
                    @foreach (var definition in _filteredDefinitions)
                    {
                        <option value="@definition.GetId()">@definition.Name (@definition.Group/@definition.Number)</option>
                    }
                </select>
            </div>
            <div class="col-auto">
                <label class="form-label" for="levelInput">Level</label>
                <input id="levelInput" class="form-control" type="number" min="0" max="15" @bind="_level" />
            </div>
            <div class="col-auto align-self-end">
                <button class="btn btn-primary" @onclick="AddItemAsync" disabled="@(string.IsNullOrEmpty(_selectedDefinitionId) || _selectedCharacter is null)">
                    Add to inventory
                </button>
            </div>
        </div>
    }
}

@code {
    private string _loginName = string.Empty;
    private string _definitionFilter = string.Empty;
    private Account? _account;
    private Character? _selectedCharacter;
    private string _selectedDefinitionId = string.Empty;
    private byte _level;
    private string? _error;
    private bool _loading;
    private List<ItemDefinition> _definitions = new();

    private IEnumerable<ItemDefinition> _filteredDefinitions
    {
        get
        {
            var filter = _definitionFilter.Trim();
            return string.IsNullOrEmpty(filter)
                ? _definitions.Take(200)
                : _definitions.Where(d => d.Name.Value?.Contains(filter, StringComparison.OrdinalIgnoreCase) is true).Take(200);
        }
    }

    protected override void OnInitialized()
    {
        try
        {
            _definitions = ConfigData.GetAll<ItemDefinition>().ToList();
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Failed to load item definitions");
            _error = "Failed to load item definitions: " + ex.Message;
        }
    }

    private async Task SearchAccountAsync()
    {
        _error = null;
        if (string.IsNullOrWhiteSpace(_loginName))
        {
            _error = "Enter an account login name.";
            return;
        }

        _loading = true;
        try
        {
            var account = await ItemGrant.FindAccountByLoginAsync(_loginName.Trim());
            if (account is null)
            {
                _error = $"No account found with login '{_loginName.Trim()}'.";
                _account = null;
                _selectedCharacter = null;
                return;
            }

            _account = await ItemGrant.LoadAccountAsync(account.GetId());
            if (_account is null)
            {
                _error = "Failed to load the account data.";
            }

            _selectedCharacter = null;
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Failed to search account");
            _error = "Search failed: " + ex.Message;
        }
        finally
        {
            _loading = false;
        }
    }

    private void SelectCharacter(Character character)
    {
        _selectedCharacter = character;
        _selectedDefinitionId = string.Empty;
    }

    private async Task AddItemAsync()
    {
        if (_selectedCharacter is null || string.IsNullOrEmpty(_selectedDefinitionId))
        {
            return;
        }

        var definition = _definitions.FirstOrDefault(d => d.GetId().ToString() == _selectedDefinitionId);
        if (definition is null)
        {
            _error = "Pick an item from the list.";
            return;
        }

        try
        {
            var item = await ItemGrant.AddItemToCharacterAsync(_selectedCharacter, definition, _level);
            if (item is null)
            {
                _error = "Failed to add the item (inventory full or save failed).";
            }
            else
            {
                _error = null;
            }

            _selectedCharacter = (await ItemGrant.LoadAccountAsync(_account!.GetId()))?.Characters.FirstOrDefault(c => c.GetId() == _selectedCharacter!.GetId());
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Failed to add item");
            _error = "Failed to add item: " + ex.Message;
        }
    }

    private async Task RemoveItemAsync(Item item)
    {
        try
        {
            var success = await ItemGrant.RemoveItemAsync(_selectedCharacter!, item);
            _error = success ? null : "Failed to remove the item.";
            _selectedCharacter = (await ItemGrant.LoadAccountAsync(_account!.GetId()))?.Characters.FirstOrDefault(c => c.GetId() == _selectedCharacter!.GetId());
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Failed to remove item");
            _error = "Failed to remove item: " + ex.Message;
        }
    }
}
