@page
@model ManageNewsModel
@{
    ViewData["Title"] = "Manage news";
}

<h1 class="h4 mb-4">Manage news</h1>

@if (TempData["Message"] is string message)
{
    <div class="alert alert-success" role="alert">@message</div>
}

<div asp-validation-summary="All" class="text-danger"></div>

<form method="post" asp-page-handler="Create" class="card card-body mb-4">
    <h2 class="h6 mb-3">Publish a new article</h2>
    <div class="mb-2">
        <label asp-for="CreateTitle" class="form-label">Title</label>
        <input asp-for="CreateTitle" class="form-control" maxlength="120" required />
    </div>
    <div class="mb-2">
        <label asp-for="CreateDate" class="form-label">Date (optional, defaults to today)</label>
        <input asp-for="CreateDate" type="date" class="form-control" />
    </div>
    <div class="mb-3">
        <label asp-for="CreateBody" class="form-label">Body</label>
        <textarea asp-for="CreateBody" class="form-control" rows="5" required></textarea>
        <div class="form-text">Line breaks are preserved; no HTML.</div>
    </div>
    <div>
        <button type="submit" class="btn btn-primary">Publish</button>
    </div>
</form>

<h2 class="h6 mb-3">Existing articles</h2>

@if (Model.Items.Count == 0)
{
    <div class="alert alert-info">No articles yet.</div>
}

@foreach (var item in Model.Items)
{
    <div class="card mb-3">
        <div class="card-body">
            <form method="post" asp-page-handler="Edit">
                <input type="hidden" name="id" value="@item.Id" />
                <div class="row g-2 mb-2">
                    <div class="col-md-9">
                        <label class="form-label small text-muted mb-0">Title</label>
                        <input name="title" class="form-control" value="@item.Title" maxlength="120" required />
                    </div>
                    <div class="col-md-3">
                        <label class="form-label small text-muted mb-0">Date</label>
                        <input name="date" type="date" class="form-control" value="@item.Date" />
                    </div>
                </div>
                <div class="mb-2">
                    <label class="form-label small text-muted mb-0">Body</label>
                    <textarea name="body" class="form-control" rows="3" required>@item.Body</textarea>
                </div>
                <div class="d-flex gap-2 align-items-center">
                    <button type="submit" class="btn btn-outline-primary btn-sm">Save changes</button>
                </div>
            </form>
            <div class="mt-2">
                <form method="post" asp-page-handler="Delete" onsubmit="return confirm('Delete this article?');">
                    <input type="hidden" name="id" value="@item.Id" />
                    <button type="submit" class="btn btn-outline-danger btn-sm">Delete</button>
                </form>
            </div>
        </div>
    </div>
}

<div class="mt-4">
    <a asp-page="/News" class="btn btn-outline-secondary btn-sm">Back to news</a>
</div>
