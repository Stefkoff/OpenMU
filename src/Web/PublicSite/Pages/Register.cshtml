@page
@model RegisterModel
@{
    ViewData["Title"] = "Register";
}

<div class="row justify-content-center">
    <div class="col-md-6 col-lg-5">
        <div class="card">
            <div class="card-body">
                <h1 class="h4 card-title text-center mb-4">Create an account</h1>

                @if (TempData["Message"] is { } message)
                {
                    <div class="alert alert-success">@message</div>
                }

                <form method="post">
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

                    <div class="mb-3">
                        <label asp-for="Input.LoginName" class="form-label">Login name</label>
                        <input asp-for="Input.LoginName" class="form-control" autocomplete="username" maxlength="10" />
                        <div class="form-text">3-10 characters, letters and numbers only. This is your in-game account name.</div>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Input.Password" class="form-label">Password</label>
                        <input asp-for="Input.Password" class="form-control" type="password" autocomplete="new-password" maxlength="20" />
                        <div class="form-text">3-20 characters.</div>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Input.ConfirmPassword" class="form-label">Confirm password</label>
                        <input asp-for="Input.ConfirmPassword" class="form-control" type="password" autocomplete="new-password" maxlength="20" />
                    </div>

                    <div class="mb-3">
                        <label asp-for="Input.SecurityCode" class="form-label">Security code</label>
                        <input asp-for="Input.SecurityCode" class="form-control" autocomplete="off" maxlength="10" />
                        <div class="form-text">Used in-game to confirm character deletion and guild kicks. Remember it!</div>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Input.EMail" class="form-label">E-mail (optional)</label>
                        <input asp-for="Input.EMail" class="form-control" type="email" autocomplete="email" />
                    </div>

                    <div class="form-check mb-3">
                        <input asp-for="Input.AgreeTerms" class="form-check-input" type="checkbox" />
                        <label asp-for="Input.AgreeTerms" class="form-check-label">I have read and accept the <a asp-page="/Rules">server rules</a>.</label>
                    </div>

                    <button type="submit" class="btn btn-primary w-100">Register</button>
                </form>

                <div class="text-center mt-3">
                    Already have an account? <a asp-page="/Login">Sign in</a>
                </div>
            </div>
        </div>
    </div>
</div>
