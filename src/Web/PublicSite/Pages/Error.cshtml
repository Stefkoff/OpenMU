@page
@model ErrorModel
@{
    ViewData["Title"] = "Error";
}

<h1 class="display-6">Something went wrong.</h1>
<p class="lead">An unexpected error occurred while processing your request.</p>

@if (Model.ShowRequestId)
{
    <p>
        <strong>Request ID:</strong> <code>@Model.RequestId</code>
    </p>
}

<p class="text-muted">Please try again. If the problem persists, contact the server administration.</p>
