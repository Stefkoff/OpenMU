@page "{tab?}"
@model RankingsModel
@{
    ViewData["Title"] = "Rankings";
}

<h1 class="h4 mb-4">Rankings</h1>

<div class="mb-3">
    <ul class="nav nav-pills">
        <li class="nav-item">
            <a class="nav-link @(Model.Tab == "level" ? "active" : "")" asp-page="/Rankings" asp-route-tab="level">Level</a>
        </li>
        <li class="nav-item">
            <a class="nav-link @(Model.Tab == "resets" ? "active" : "")" asp-page="/Rankings" asp-route-tab="resets">Resets</a>
        </li>
        <li class="nav-item">
            <a class="nav-link @(Model.Tab == "master" ? "active" : "")" asp-page="/Rankings" asp-route-tab="master">Master level</a>
        </li>
        <li class="nav-item">
            <a class="nav-link @(Model.Tab == "guilds" ? "active" : "")" asp-page="/Rankings" asp-route-tab="guilds">Guilds</a>
        </li>
    </ul>
</div>

@if (Model.Tab == "guilds")
{
    if (Model.Guilds.Count == 0)
    {
        <div class="alert alert-info">No guilds yet.</div>
    }
    else
    {
        <div class="card">
            <div class="table-responsive">
                <table class="table table-dark table-hover align-middle mb-0">
                    <thead>
                        <tr>
                            <th>#</th>
                            <th>Guild</th>
                            <th class="text-end">Members</th>
                            <th class="text-end">Score</th>
                        </tr>
                    </thead>
                    <tbody>
                        @for (var i = 0; i < Model.Guilds.Count; i++)
                        {
                            <tr>
                                <td>@(i + 1)</td>
                                <td>@Model.Guilds[i].GuildName</td>
                                <td class="text-end">@Model.Guilds[i].Members</td>
                                <td class="text-end">@Model.Guilds[i].Score</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }
}
else
{
    if (Model.Characters.Count == 0)
    {
        <div class="alert alert-info">No characters yet.</div>
    }
    else
    {
        <div class="card">
            <div class="table-responsive">
                <table class="table table-dark table-hover align-middle mb-0">
                    <thead>
                        <tr>
                            <th>#</th>
                            <th>Name</th>
                            <th>Class</th>
                            <th class="text-end">Level</th>
                            <th class="text-end">Master</th>
                            <th class="text-end">Resets</th>
                        </tr>
                    </thead>
                    <tbody>
                        @for (var i = 0; i < Model.Characters.Count; i++)
                        {
                            var row = Model.Characters[i];
                            <tr>
                                <td>@(i + 1)</td>
                                <td>@row.CharacterName</td>
                                <td>@row.ClassName</td>
                                <td class="text-end">@row.Level</td>
                                <td class="text-end">@row.MasterLevel</td>
                                <td class="text-end">@row.Resets</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }
}
